PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marathon_db
JWT_SECRET=your_jwt_secret
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password
SMTP_HOST=smtp.gmail.com


SMTP_PORT=465
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=your_smtp_from_email
BASE_URL=http://localhost:5000
MARATHON_DATE=2026-07-31T06:00:00+05:30

# Meta WhatsApp Cloud API Settings (Option B)
WA_ACCESS_TOKEN=your_meta_system_user_token
WA_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Twilio API Settings (For SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Disable WhatsApp
DISABLE_WHATSAPP=true

# Salesforce CRM Configurations
SF_LOGIN_URL=https://login.salesforce.com
SF_USERNAME=your_salesforce_username
SF_PASSWORD=your_salesforce_password
SF_SECURITY_TOKEN=your_salesforce_security_token
SF_CLIENT_ID=your_salesforce_consumer_key
SF_CLIENT_SECRET=your_salesforce_consumer_secret

# Zoho CRM Configurations
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in/crm/v3
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token

# --- WhatsApp Automation ---
# cloud  = Meta WhatsApp Cloud API (recommended, no QR scan needed)
# twilio = Twilio WhatsApp
# mock   = log messages to console (default when unconfigured)
WHATSAPP_PROVIDER=mock
WA_ACCESS_TOKEN=your_meta_system_user_token
WA_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WA_API_VERSION=v21.0
WA_DEFAULT_COUNTRY_CODE=91
# Approved Meta template, used outside the 24-hour customer-service window.
WA_TEMPLATE_NAME=
WA_TEMPLATE_LANG=en_US
# Legacy browser-based client (needs QR scan + Chrome). Keep false.
WHATSAPP_WEB_CLIENT=false
